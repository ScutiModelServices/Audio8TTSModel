# Copy to .env (git-ignored). Docker compose and a local run (run.bat) read it from this folder; a real environment variable wins.
# Start-up values only: a value saved on the admin Settings card (/admin/) beats .env.

# Admin password: unlocks /admin/, where you create a token per caller; callers send theirs as X-Internal-Token.
# Voices are added with the admin password too. Empty = no auth at all (local use only).
AUDIO8_ADMIN_PASSWORD=

# Port the service listens on (compose: the port published by the load balancer).
AUDIO8_PORT=9200

# Compose only: API copies behind nginx. Each copy loads the model on the GPU (about 2.5 GB of weights, check nvidia-smi).
AUDIO8_REPLICAS=1

# CPU threads for what runs on the CPU (reference clip loading). Set the physical core count, not the logical one.
# A value saved on the /admin/ page beats this one.
# AUDIO8_NUM_THREAD=4

# Tunables (update check hours, in-flight cap, answers kept, model revision, device, data type, token limit, load at
# start) are set on the /admin/ Settings card and saved in settings.json. These variables are only a starting value for
# run.bat; compose does not pass them. A saved value wins.
# AUDIO8_UPDATE_CHECK_HOURS=6
# AUDIO8_MAX_INFLIGHT=
# AUDIO8_MODEL_REVISION=23c305cc013fde378edb459f538317043c993a74
# AUDIO8_DEVICE=cuda
# AUDIO8_DTYPE=bfloat16
# AUDIO8_WARM=1

# run.bat only (compose sets these itself): bind address.
# AUDIO8_HOST=127.0.0.1
# Where tokens are stored (hashed), the reference voices and the admin page folder. Docker sets /data/tokens.json,
# /voices and /app/web.
# AUDIO8_TOKENS_FILE=tokens.json
# AUDIO8_VOICES_DIR=_voices
# AUDIO8_WEB_DIR=web
